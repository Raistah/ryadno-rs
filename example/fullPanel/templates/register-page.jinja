{% extends "base.jinja" %}
{% block body %}
	<div class="w-full max-w-[560px]">
		<form
			class="flex flex-col w-full gap-4 py-4 px-6 bg-white rounded-md shadow-md"
			action="{{ action }}"
			method="post"
		>
			<h1 class="text-2xl font-bold text-cyan-900">Registration</h1>
			<input
				class="py-2 px-4 border-2 border-cyan-800 rounded-md shadow-sm"
				name="email"
				placeholder="Email"
				value="admin@admin.com"
				required
			/>
			<input
				class="py-2 px-4 border-2 border-cyan-800 rounded-md shadow-sm"
				name="password"
				type="password"
				value="123123"
				placeholder="Password"
				required
			/>
			<input
				class="py-2 px-4 border-2 border-cyan-800 rounded-md shadow-sm"
				name="password_conf"
				type="password"
				value="123123"
				placeholder="Confirm password"
				required
			/>
			<input
				class="py-2 px-4 border-2 border-cyan-800 rounded-md shadow-sm"
				name="register_token"
				type="text"
				value="hehe hehe"
				placeholder="Registration Token"
				required
			/>
			<button
				class="
					py-2 px-4 text-white font-medium border-2 border-cyan-800 bg-cyan-800 rounded-md shadow-sm transition-colors duration-300
					hover:bg-cyan-700
				"
				role="sumbit"
			>
				Register
			</button>
	 	</form>
	</div>
{% endblock %}
