{% extends "ryadno/fields/base.jinja" %}
{% block field_body %}
	<label>
		<span class="block">{{label}}</span>
		<input
			type="{{input_type}}"
			data-bind="{{uuid}}.value"
			data-on:input__debounce.500ms="
				@post(
					`{{form_context.update_endpoint}}`,
					{
						headers: {{form_context.headers | replace('\"', '\'')}},
						payload: {
							uuid: '{{uuid}}',
							path: ${{uuid}}.path,
							value: ${{uuid}}.value,
						}
					}
				)
			"
		/>
		<p data-text="${{uuid}}.value"></p>
	</label>
{% endblock %}
